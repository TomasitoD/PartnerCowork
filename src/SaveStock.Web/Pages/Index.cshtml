@page
@model IndexModel
@{
    ViewData["Title"] = "Inicio";
}

<h1>SaveStock</h1>
<p>Inventario para negocios pequeños.</p>

@if (Model.UsuarioActual is { } usuario)
{
    <p>Hola, <strong>@usuario.Nombre</strong>. Tu rol es <strong>@PaginaSaveStock.TextoRol(usuario.Rol)</strong>.</p>
}
else
{
    <p class="tenue">No has iniciado sesión.</p>
}

