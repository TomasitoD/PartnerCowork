@page "/contrasena/recuperar"
@model RecuperarModel
@{
    ViewData["Title"] = "Recuperar contraseña";
}

<h1>Recuperar la contraseña</h1>

<partial name="_Mensaje" model="Model.Mensaje" />

<form method="post" class="formulario">
    <label>Correo
        <input asp-for="Correo" type="email" autocomplete="email" />
    </label>
    <button type="submit">Enviarme un código</button>
</form>

<p><a href="/contrasena/restablecer">Ya tengo un código</a></p>
