# Copia este archivo como .env y completa los valores. El .env nunca se sube al repositorio (RD-10).
# Las rutas relativas se resuelven desde la carpeta donde se ejecuta el comando (la raíz del repo).

# Archivo SQLite del Core (la web y el enviador usan el mismo). Default: datos/savestock.db
SAVESTOCK_DB_RUTA=
# Archivo SQLite del inventario. Default: datos/inventario.db
SAVESTOCK_INVENTARIO_DB_RUTA=
# URL pública de la web, para armar los enlaces de los correos. Default: http://localhost:5080
SAVESTOCK_URL_BASE=

# Administrador inicial: se crea activado al iniciar la web si no existe. Si falta alguno, no se crea.
SAVESTOCK_ADMIN_CORREO=
SAVESTOCK_ADMIN_CONTRASENA=
SAVESTOCK_ADMIN_NOMBRE=

# Servidor de correo (solo lo usa SaveStock.Enviador).
SMTP_HOST=
# Puerto del servidor SMTP. Default: 587
SMTP_PUERTO=
SMTP_USUARIO=
SMTP_CONTRASENA=
# Dirección que aparece como remitente de los correos.
SMTP_REMITENTE=
